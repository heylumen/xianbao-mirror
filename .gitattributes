# Git LFS: 把仓库内所有图片二进制移出版本历史, 仅存指针
# 根治 xianbao-mirror 体积失控(月增 ~400MB)与部署/克隆越来越慢的问题。
# 注意: 路径必须覆盖 xianbao/ 下全部图片(主题/插件/远程图床/头像/上传)。
xianbao/**/*.jpg filter=lfs diff=lfs merge=lfs -text
xianbao/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
xianbao/**/*.png filter=lfs diff=lfs merge=lfs -text
xianbao/**/*.gif filter=lfs diff=lfs merge=lfs -text
xianbao/**/*.webp filter=lfs diff=lfs merge=lfs -text
xianbao/**/*.bmp filter=lfs diff=lfs merge=lfs -text
xianbao/**/*.avif filter=lfs diff=lfs merge=lfs -text
