# Actions 内部状态文件，不需要发布到 Vercel
xianbao/.crawl-state.json
xianbao/.dead_remote_imgs.json
xianbao/.mirror-meta.json

# link-map.json（约 25MB）：本意为「死链重定向中间件」提供 URL->本地路径映射，
# 但本站是纯静态部署（vercel.json 无 routes/functions），并不存在中间件，
# 经核查全站 0 处引用。生成逻辑已同步移除，此处排除以免历史产物仍被上传。
xianbao/link-map.json

# search.json（约 28MB）：完整归档索引，含 content_clean/tags/author 等归档字段。
# 前端搜索页实际只加载轻量版 search-lite.json（约 19MB，已含正文全文与评论），
# 经核查无任何前端 fetch 指向 search.json（降级页也已统一改用 lite 版）。
# 仍保留在 git 中作归档用途，仅不参与部署，以免拖慢发布。
xianbao/search.json

# archive/（实测 251MB / 30,648 个文件）：重渲染前的旧版本快照，仅供本地回滚，
# 没有任何页面引用。此前被当作普通静态文件上传，既公开暴露内部快照
# （线上 /archive/<cat>/<id>/dead.html 实测 200），又显著拖慢发布，
# 且文件数占全站 32%。此处排除出部署；本地与 git 中的归档不受影响。
xianbao/archive/

# 主题菜单动态模板（爬取时从源站同步生成，仅构建期使用，不需要公开）
xianbao/.mirror-theme-menu.html
