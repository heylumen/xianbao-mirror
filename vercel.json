{
  "buildCommand": "echo 'xianbao/ 由 GitHub Actions 预渲染并提交，Vercel 直接发布该静态产物，无需在 Vercel 侧执行 Playwright'",
  "outputDirectory": "xianbao",
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/search-lite.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
